{
  "name": "uav-docs-mirror",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "SKIP_GIT_SYNC=true node src/index.js",
    "prod": "SKIP_GIT_SYNC=false node src/index.js",
    "watch": "node src/index.js --watch",
    "build": "node src/index.js --no-deploy",
    "check": "node --check src/index.js && node --check src/rewrite.js && node --check src/utils.js",
    "sync": "node src/index.js --once",
    "sync:site": "node src/index.js"
  },
  "dependencies": {
    "axios": "^1.7.3",
    "cheerio": "^1.1.0"
  }
}
